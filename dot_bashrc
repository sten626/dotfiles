# shellcheck shell=bash
# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment

# shellcheck source=./dot_config/bash/env.sh
[ -f "$XDG_CONFIG_HOME/bash/env.sh" ] && . "$XDG_CONFIG_HOME/bash/env.sh"

# shellcheck source=/dev/null
[ -f "$XDG_CONFIG_HOME/bash/exports.sh" ] && . "$XDG_CONFIG_HOME/bash/exports.sh"

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions

# shellcheck source=./dot_config/bash/aliases.sh.tmpl
[ -f "$XDG_CONFIG_HOME/bash/aliases.sh" ] && . "$XDG_CONFIG_HOME/bash/aliases.sh"
# shellcheck source=./dot_config/bash/functions.sh
[ -f "$XDG_CONFIG_HOME/bash/functions.sh" ] && . "$XDG_CONFIG_HOME/bash/functions.sh"

# Any local overrides should be placed in local.sh, which is not tracked by chezmoi.
# shellcheck source=/dev/null
[ -f "$XDG_CONFIG_HOME/bash/local.sh" ] && . "$XDG_CONFIG_HOME/bash/local.sh"
