[advice]
	detachedHead = false

[alias]
	# Simple aliases.
	br = branch
	c = clone
	ci = commit
	co = checkout
	cp = cherry-pick
	d = diff
	f = fetch --prune --prune-tags
	m = merge
	p = push
	r = rebase

	# Bisect shortcuts.
	bb = bisect bad
	bi = bisect
	bg = bisect good
	bre = bisect reset
	bs = bisect skip
	bv = !git bisect visualize &

	# "Pluralize" various listing commands.
	branches = branch --all
	remotes = remote --verbose
	tags = tag --list

	# List aliases.
	aliases = config --get-regexp alias

	# Commit all changes.
	ca = !git add --all && git commit --all

	# Clean
	# Want to rethink this clean alias for nuking build artifacts
	# cl = clean -dx --force -e .idea

	# Find branches containing commit.
	fb = branch --all --contains

	# Find tags containing commit.
	ft = describe --always --contains

	# View abbreviated SHA, description, and history graph of the latest 20 commits.
	l = log --pretty=oneline --max-count=20 --graph --abbrev-commit

	# View the current working tree status using the short format.
	s = status --short

[apply]
	# Detect whitespace errors when applying a patch.
	whitespace = fix

[commit]
	# Show diff while committing.
	verbose = true

[core]
	# excludesfile = ~/.gitignore

[include]
	# Include any local configuration.
	# path = ~/.gitconfig.local

[pull]
	# Rebase the current branch on top of upstream.
	rebase = true

[push]
	# Make `push` push relevant tags when pushing branches.
	followTags = true

[user]
	email = {{ .email }}
	name = {{ .name }}
