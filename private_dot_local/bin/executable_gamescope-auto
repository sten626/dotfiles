#!/bin/bash

# Capture Steam's overlay preload if present
steam_preload="$LD_PRELOAD"

# Find the active primary display
primary_dir=""
for card in /sys/class/drm/card*-*; do
  if [ -f "$card/status" ] && [ "$(cat "$card/status")" = "connected" ]; then
    if [ -f "$card/enabled" ] && [ "$(cat "$card/enabled")" = "enabled" ]; then
      if [ -f "$card/primary" ] && [ "$(cat "$card/primary")" = "1" ]; then
        primary_dir="$card"
        break
      fi

      # Fallback: use this enabled card if we haven't explicitly found primary yet
      [ -z "$primary_dir" ] && primary_dir="$card"
    fi
  fi
done

# Extract the first active mode (native resolution) from the modes file
if [ -n "$primary_dir" ] && [ -f "$primary_dir/modes" ]; then
  native_res=$(head --lines 1 "$primary_dir/modes")
  width=$(echo "$native_res" | cut --delimiter x --fields 1)
  height=$(echo "$native_res" | cut --delimiter x --fields 2)
fi

# Default fallback if something went wrong
if [ -z "$width" ] || [ -z "$height" ]; then
  width=1920
  height=1080
fi

# Separate any gamescope flags from the child game command
gamescope_args=()
game_cmd=()
found_sep=false

for arg in "$@"; do
  if [ "$found_sep" = true ]; then
    game_cmd+=("$arg")
  elif [ "$arg" = "--" ]; then
    found_sep=true
  else
    gamescope_args+=("$arg")
  fi
done

# If no '--' was provided, assume arguments without leading dashes are the game command
if [ "$found_sep" = false ]; then
  if [ "$#" -gt 0 ] && [[ "$1" != -* ]]; then
    game_cmd=("$@")
    gamescope_args=()
  else
    gamescope_args=("$@")
  fi
fi

# Run gamescope with LD_PRELOAD isolated to the game process
if [ -n "$steam_preload" ] && [ ${#game_cmd[@]} -gt 0 ]; then
  exec env -u LD_PRELOAD gamescope --fullscreen --output-width "$width" --output-height "$height" "${gamescope_args[@]}" -- env LD_PRELOAD="$steam_preload" "${game_cmd[@]}"
elif [ ${#game_cmd[@]} -gt 0 ]; then
  exec gamescope --fullscreen --output-width "$width" --output-height "$height" "${gamescope_args[@]}" -- "${game_cmd[@]}"
else
  exec gamescope --fullscreen --output-width "$width" --output-height "$height" "${gamescope_args[@]}"
fi
