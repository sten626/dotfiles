# shellcheck shell=bash
# chezmoi:template:left-delimiter="# {{"

# Navigation

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

# Shortcuts

alias c='clear'
alias g='git'
alias m='man'
alias n='npm'
alias s='switchto'
alias w='cd $HOME/workspace'

# Disk usage sorted

alias dus='du --human-readable --max-depth 2 * | sort --human-numeric-sort'

# Kill

alias k='kill'
alias k9='kill -9'
alias ku1='kill -USR1'

# Enable any OS specific aliases

# {{- if eq .osid "linux-centos" "linux-fedora" }}
alias i='sudo dnf install'
alias u='sudo dnf upgrade; command -v pnpm &> /dev/null && pnpm -g update'
# {{- else if eq .osid "linux-ubuntu" }}
alias i='sudo apt install'
alias u='sudo apt update && sudo apt upgrade; command -v pnpm &> /dev/null && pnpm -g update'
# {{- end }}
